# Configuration de production — copié en deploy/.env.prod SUR LE SERVEUR par server-setup.sh,
# qui remplace chaque « __GENERATE__ » par un secret aléatoire. Ne jamais commiter .env.prod.

# Adresse de l'application : nom de domaine (DNS A vers le serveur) ou adresse IP
DOMAIN=__DOMAIN__
# Certificat HTTPS : e-mail → Let's Encrypt (domaine) ; « internal » → auto-signé (adresse IP)
TLS=__TLS__

# PostgreSQL (POSTGRES_DB doit rester « amc » : le script d'initialisation s'y connecte)
POSTGRES_USER=amc
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=amc

# MinIO (stockage des fichiers, jamais exposé sur Internet)
MINIO_ROOT_USER=amc_minio
MINIO_ROOT_PASSWORD=__GENERATE__

# E-mails : « disabled » = tracés dans l'application mais non envoyés
EMAIL_MODE=disabled
# Pour un vrai serveur d'envoi, plus tard :
# EMAIL_MODE=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=AMC Platform <no-reply@mondomaine.com>
