{
  "name": "@amc/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST /api/v1 — NestJS modular monolith (Identity, Access, Fleet, Members, Certificates, CSO, Procurement, Voyages, Noon, Notifications, Files, Audit, Reporting)",
  "scripts": {
    "build": "nest build",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "dotenv -e ../../.env -- nest start --watch",
    "openapi": "ts-node --transpile-only scripts/generate-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:status": "dotenv -e ../../.env -- prisma migrate status",
    "prisma:diff": "dotenv -e ../../.env -- node scripts/prisma-diff.js",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed && npm run seed",
    "seed": "dotenv -e ../../.env -- ts-node --transpile-only prisma/seed.ts",
    "import:crew-matrix": "dotenv -e ../../.env -- ts-node --transpile-only prisma/import-crew-matrix.ts",
    "test": "dotenv -e ../../.env -- jest --runInBand",
    "test:watch": "dotenv -e ../../.env -- jest --watch"
  },
  "dependencies": {
    "@amc/types": "0.1.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "5.22.0",
    "archiver": "7.0.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "file-type": "16.5.4",
    "helmet": "8.0.0",
    "ioredis": "^5.4.1",
    "nestjs-zod": "3.0.0",
    "nodemailer": "6.9.16",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.15.2",
    "prisma": "5.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sharp": "0.33.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.2.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@types/archiver": "6.0.3",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.12",
    "@types/node": "20.17.10",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.13.8",
    "@types/supertest": "6.0.2",
    "@types/yauzl": "2.10.3",
    "dotenv-cli": "^7.4.4",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@amc/types$": "<rootDir>/../../packages/types/src"
    }
  }
}
