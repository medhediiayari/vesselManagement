  vessel Vessel @relation(fields: [vesselId], references: [id])

  @@index([vesselId, archivedAt])
  @@map("vessel_attachments")
}

enum MemberStatus {
  ON_BOARD
  AVAILABLE
  ON_LEAVE
  PLANNED_JOIN
  INACTIVE
}

enum CrewDepartment {
  DECK
  ENGINE
  CATERING
  OTHER
}

model Rank {
