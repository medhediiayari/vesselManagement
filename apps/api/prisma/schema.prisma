// =============================================================================
// AMC — Plateforme maritime : modèle relationnel PostgreSQL (CDC §10 / §13)
// Conventions :
//  - PK UUID ; created_at / updated_at en UTC (timestamptz) ; tables snake_case
//  - Montants DECIMAL(18,2) / prix DECIMAL(18,4) ; quantités DECIMAL(18,3) + unité
//  - Les blobs (PDF, Excel, images) ne sont JAMAIS stockés en base : table `files`
//    -> objet immuable dans MinIO (bucket privé) + SHA-256 + statut antivirus
//  - Invariants non exprimables en Prisma (index partiels, triggers append-only,
//    colonnes FTS générées, CHECK) : migration SQL `0002_db_hardening`
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // native (poste de dev) + Debian/OpenSSL 3 (images Docker node:20-bookworm-slim)
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  extensions        = [pg_trgm, unaccent]
}

// =============================================================================
// PLATFORM — sociétés, paramètres, fichiers, audit, notifications, jobs
// =============================================================================

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users     User[]
  vessels   Vessel[]
  members   Member[]
  suppliers Supplier[]

  @@map("companies")
}

/// Paramètres modifiables par le Super Admin (timeout d'inactivité, champs self-edit, limites…)
model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

/// Séquences de numérotation métier (PR, BC, RFQ, références CSO…), verrouillées en transaction.
model NumberSequence {
  key       String   @id @db.VarChar(120)
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("number_sequences")
}

enum FileKind {
  PDF
  EXCEL
  IMAGE
  ZIP
  CSV
  WORD
  OTHER
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  /// Antivirus désactivé : statut explicite, jamais confondu avec CLEAN
  SKIPPED
  ERROR
}

enum FileContext {
  CERTIFICATE
  CSO_DOCUMENT
  VESSEL_PHOTO
  VESSEL_ATTACHMENT
  MEMBER_PHOTO
  MEMBER_DOCUMENT
  PURCHASING
  VOYAGE
  CHARTER_PARTY
  NOON_REPORT
  IMPORT_SOURCE
  EXPORT
  GENERATED
}

/// Blob immuable stocké dans MinIO. Un document logique (certificat, version CSO, BL…)
/// référence un `files.id`. Le lien propriétaire (owner_type/owner_id) est posé une seule fois
/// et sert à résoudre les droits lors d'un preview/download (aucune clé objet exposée).
model StoredFile {
  id             String         @id @default(uuid()) @db.Uuid
  bucket         String         @db.VarChar(63)
  objectKey      String         @map("object_key") @db.VarChar(512)
  originalName   String         @map("original_name") @db.VarChar(255)
  extension      String         @db.VarChar(16)
  mimeType       String         @map("mime_type") @db.VarChar(127)
  kind           FileKind
  sizeBytes      BigInt         @map("size_bytes")
  sha256         String         @db.Char(64)
  scanStatus     FileScanStatus @default(PENDING) @map("scan_status")
  scanDetail     String?        @map("scan_detail") @db.VarChar(500)
  scannedAt      DateTime?      @map("scanned_at") @db.Timestamptz(3)
  context        FileContext
  /// Navire de rattachement (scope) lorsque connu dès le dépôt
  vesselId       String?        @map("vessel_id") @db.Uuid
  ownerType      String?        @map("owner_type") @db.VarChar(64)
  ownerId        String?        @map("owner_id") @db.Uuid
  attachedAt     DateTime?      @map("attached_at") @db.Timestamptz(3)
  /// Métadonnées techniques (images : dimensions ; PDF : nombre de pages)
  width          Int?
  height         Int?
  pageCount      Int?           @map("page_count")
  thumbnailKey   String?        @map("thumbnail_key") @db.VarChar(512)
  uploadedById   String?        @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  retentionUntil DateTime?      @map("retention_until") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  uploadedBy User?   @relation("FileUploader", fields: [uploadedById], references: [id])
  vessel     Vessel? @relation(fields: [vesselId], references: [id])

  @@index([sha256])
  @@index([ownerType, ownerId])
  @@index([scanStatus])
  @@index([uploadedById, createdAt])
  @@map("files")
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

/// Journal d'audit append-only (trigger anti UPDATE/DELETE en migration SQL).
/// Volontairement sans clé étrangère : indépendant du cycle de vie métier.
model AuditEvent {
  id         String      @id @default(uuid()) @db.Uuid
  occurredAt DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId    String?     @map("actor_id") @db.Uuid
  actorLabel String?     @map("actor_label") @db.VarChar(200)
  action     String      @db.VarChar(100)
  module     String      @db.VarChar(40)
  entityType String      @map("entity_type") @db.VarChar(60)
  entityId   String?     @map("entity_id") @db.VarChar(64)
  vesselId   String?     @map("vessel_id") @db.Uuid
  result     AuditResult @default(SUCCESS)
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?     @db.VarChar(64)
  userAgent  String?     @map("user_agent") @db.VarChar(400)
  sessionId  String?     @map("session_id") @db.Uuid
  requestId  String?     @map("request_id") @db.VarChar(64)

  @@index([module, occurredAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([vesselId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

/// Clés d'idempotence pour mutations critiques (réceptions, approbations, envois)
model IdempotencyKey {
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.VarChar(128)
  route          String   @db.VarChar(200)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, key])
  @@map("idempotency_keys")
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  type        String               @db.VarChar(80)
  title       String               @db.VarChar(250)
  body        String?
  priority    NotificationPriority @default(NORMAL)
  module      String               @db.VarChar(40)
  entityType  String?              @map("entity_type") @db.VarChar(60)
  entityId    String?              @map("entity_id") @db.Uuid
  vesselId    String?              @map("vessel_id") @db.Uuid
  link        String?              @db.VarChar(500)
  /// Alerte obligatoire : ne disparaît pas sur simple lecture
  isMandatory Boolean              @default(false) @map("is_mandatory")
  dedupeKey   String?              @map("dedupe_key") @db.VarChar(200)
  readAt      DateTime?            @map("read_at") @db.Timestamptz(3)
  resolvedAt  DateTime?            @map("resolved_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User            @relation(fields: [userId], references: [id])
  deliveries EmailDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SUPPRESSED
}

model EmailDelivery {
  id                String      @id @default(uuid()) @db.Uuid
  notificationId    String?     @map("notification_id") @db.Uuid
  toAddress         String      @map("to_address") @db.VarChar(320)
  subject           String      @db.VarChar(300)
  bodyText          String      @map("body_text")
  bodyHtml          String?     @map("body_html")
  status            EmailStatus @default(QUEUED)
  attempts          Int         @default(0)
  lastError         String?     @map("last_error") @db.VarChar(1000)
  providerMessageId String?     @map("provider_message_id") @db.VarChar(300)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  notification Notification?        @relation(fields: [notificationId], references: [id])
  events       EmailDeliveryEvent[]

  @@index([status, createdAt])
  @@map("email_deliveries")
}

model EmailDeliveryEvent {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @map("delivery_id") @db.Uuid
  event      String   @db.VarChar(40)
  detail     String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery EmailDelivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId])
  @@map("email_delivery_events")
}

/// Règles de notification génériques (événements hors certificats)
model NotificationRule {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(80)
  name       String   @db.VarChar(200)
  /// [{type: 'USER'|'ROLE'|'DEPARTMENT', id}]
  recipients Json
  channels   String[] @default(["APP", "EMAIL"])
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([eventType, isActive])
  @@map("notification_rules")
}

/// Transactional outbox : écrit dans la même transaction que le changement d'état
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(80)
  aggregateType String    @map("aggregate_type") @db.VarChar(60)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(1000)

  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  jobName    String    @map("job_name") @db.VarChar(80)
  status     JobStatus
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  detail     Json?

  @@index([jobName, startedAt(sort: Desc)])
  @@map("job_runs")
}

enum ExportFormat {
  CSV
  XLSX
  PDF
  ZIP
}

model ExportJob {
  id            String       @id @default(uuid()) @db.Uuid
  format        ExportFormat
  module        String       @db.VarChar(40)
  resource      String       @db.VarChar(60)
  params        Json
  status        JobStatus    @default(QUEUED)
  fileId        String?      @map("file_id") @db.Uuid
  itemCount     Int?         @map("item_count")
  /// Éléments exclus faute de droits (jamais détaillés au demandeur)
  excludedCount Int?         @map("excluded_count")
  error         String?      @db.VarChar(1000)
  requestedById String       @map("requested_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt    DateTime?    @map("finished_at") @db.Timestamptz(3)

  requestedBy User @relation(fields: [requestedById], references: [id])

  @@index([requestedById, createdAt(sort: Desc)])
  @@map("export_jobs")
}

enum ImportJobKind {
  MEMBERS
  CSO_DOCUMENTS
}

enum ImportPhase {
  UPLOADED
  MAPPING
  PREVIEW_READY
  COMMITTING
  COMMITTED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE_SUSPECTED
  APPLIED
  SKIPPED
  FAILED
}

enum ImportRowDecision {
  PENDING
  CREATE
  UPDATE
  IGNORE
  CORRECT
  CREATE_INDEPENDENT
  SUBMIT_NEW_VERSION
}

/// Import en masse (Excel Members, ZIP/Excel CSO) : mapping -> prévisualisation -> décisions -> commit
model ImportJob {
  id           String      @id @default(uuid()) @db.Uuid
  kind         ImportJobKind
  status       JobStatus   @default(QUEUED)
  phase        ImportPhase @default(UPLOADED)
  sourceFileId String      @map("source_file_id") @db.Uuid
  /// Fichier Excel de métadonnées complémentaire (import CSO)
  metadataFileId String?   @map("metadata_file_id") @db.Uuid
  vesselId     String?     @map("vessel_id") @db.Uuid
  targetFolderId String?   @map("target_folder_id") @db.Uuid
  /// Feuilles sélectionnées, mapping colonnes -> champs, options
  options      Json        @default("{}")
  summary      Json?
  errorMessage String?     @map("error_message") @db.VarChar(1000)
  createdById  String      @map("created_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt    DateTime?   @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?   @map("finished_at") @db.Timestamptz(3)

  createdBy User        @relation(fields: [createdById], references: [id])
  rows      ImportRow[]

  @@index([kind, createdAt(sort: Desc)])
  @@map("import_jobs")
}

model ImportRow {
  id                  String            @id @default(uuid()) @db.Uuid
  jobId               String            @map("job_id") @db.Uuid
  sheetName           String            @default("") @map("sheet_name") @db.VarChar(120)
  rowNumber           Int               @map("row_number")
  raw                 Json
  normalized          Json?
  errors              Json?
  warnings            Json?
  duplicateCandidates Json?             @map("duplicate_candidates")
  status              ImportRowStatus   @default(PENDING)
  decision            ImportRowDecision @default(PENDING)
  decisionTargetId    String?           @map("decision_target_id") @db.Uuid
  decidedById         String?           @map("decided_by_id") @db.Uuid
  decidedAt           DateTime?         @map("decided_at") @db.Timestamptz(3)
  appliedEntityId     String?           @map("applied_entity_id") @db.Uuid
  appliedAt           DateTime?         @map("applied_at") @db.Timestamptz(3)
  errorMessage        String?           @map("error_message") @db.VarChar(1000)

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sheetName, rowNumber])
  @@index([jobId, status])
  @@map("import_rows")
}

// =============================================================================
// IDENTITY & ACCESS — utilisateurs, sessions, rôles, permissions, scopes, départements
// =============================================================================

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum VesselScopeMode {
  /// Toute la flotte, y compris les navires créés ultérieurement (ADM-003)
  ALL_FLEET
  SELECTED
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  /// Stocké normalisé (minuscules)
  username           String          @unique @db.VarChar(64)
  /// Normalisé (minuscules) ; unique lorsqu'il est présent
  email              String?         @unique @db.VarChar(320)
  emailVerifiedAt    DateTime?       @map("email_verified_at") @db.Timestamptz(3)
  displayName        String          @map("display_name") @db.VarChar(200)
  /// Argon2id
  passwordHash       String          @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean         @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?       @map("password_changed_at") @db.Timestamptz(3)
  status             UserStatus      @default(ACTIVE)
  failedLogins       Int             @default(0) @map("failed_logins")
  lockedAt           DateTime?       @map("locked_at") @db.Timestamptz(3)
  lastLoginAt        DateTime?       @map("last_login_at") @db.Timestamptz(3)
  vesselScope        VesselScopeMode @default(SELECTED) @map("vessel_scope")
  /// Lien facultatif 1:1 vers la fiche Member (ADM-031)
  memberId           String?         @unique @map("member_id") @db.Uuid
  jobTitle           String?         @map("job_title") @db.VarChar(120)
  locale             String          @default("fr") @db.VarChar(8)
  createdById        String?         @map("created_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deactivatedAt      DateTime?       @map("deactivated_at") @db.Timestamptz(3)

  company             Company                @relation(fields: [companyId], references: [id])
  member              Member?                @relation("UserMember", fields: [memberId], references: [id])
  sessions            Session[]
  roles               UserRole[]             @relation("UserRoles")
  overrides           PermissionOverride[]   @relation("UserOverrides")
  vesselAccess        UserVesselAccess[]     @relation("UserVesselAccess")
  departments         DepartmentMembership[]
  deputyOf            DepartmentDeputy[]
  managedDepartments  Department[]           @relation("DepartmentPrimaryManager")
  resetTokens         PasswordResetToken[]
  notifications       Notification[]
  uploadedFiles       StoredFile[]           @relation("FileUploader")
  importJobs          ImportJob[]
  exportJobs          ExportJob[]

  @@index([companyId, status])
  @@map("users")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// SHA-256 du jeton à usage unique (jamais stocké en clair)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// SHA-256 du jeton de session (cookie HttpOnly)
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  deviceLabel   String?   @map("device_label") @db.VarChar(200)
  userAgent     String?   @map("user_agent") @db.VarChar(400)
  ip            String?   @db.VarChar(64)
  fingerprint   String?   @db.VarChar(128)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  revokedReason String?   @map("revoked_reason") @db.VarChar(200)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  /// Rôle système protégé (SUPER_ADMIN) : non modifiable, non supprimable
  isSystem    Boolean  @default(false) @map("is_system")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  key         String  @id @db.VarChar(80)
  module      String  @db.VarChar(40)
  label       String  @db.VarChar(250)
  isSensitive Boolean @default(false) @map("is_sensitive")

  roles     RolePermission[]
  overrides PermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key") @db.VarChar(80)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

enum OverrideEffect {
  ALLOW
  DENY
}

/// Exceptions individuelles : DENY > ALLOW > union des rôles (ADM-022)
model PermissionOverride {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  permissionKey String         @map("permission_key") @db.VarChar(80)
  effect        OverrideEffect
  reason        String?        @db.VarChar(500)
  createdById   String?        @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation("UserOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@unique([userId, permissionKey])
  @@map("permission_overrides")
}

/// Navires explicitement accessibles quand vessel_scope = SELECTED
model UserVesselAccess {
  userId      String   @map("user_id") @db.Uuid
  vesselId    String   @map("vessel_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user   User   @relation("UserVesselAccess", fields: [userId], references: [id], onDelete: Cascade)
  vessel Vessel @relation(fields: [vesselId], references: [id])

  @@id([userId, vesselId])
  @@index([vesselId])
  @@map("user_vessel_access")
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

model Department {
  id               String           @id @default(uuid()) @db.Uuid
  code             String           @unique @db.VarChar(32)
  name             String           @db.VarChar(120)
  status           DepartmentStatus @default(ACTIVE)
  primaryManagerId String?          @map("primary_manager_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  primaryManager User?                  @relation("DepartmentPrimaryManager", fields: [primaryManagerId], references: [id])
  memberships    DepartmentMembership[]
  deputies       DepartmentDeputy[]

  @@map("departments")
}

/// Un département principal (index partiel unique) + secondaires (ADM-024)
model DepartmentMembership {
  userId       String   @map("user_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("department_memberships")
}

model DepartmentDeputy {
  departmentId String @map("department_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([departmentId, userId])
  @@map("department_deputies")
}

// =============================================================================
// FLEET & CREW — navires, Members, affectations, champs personnalisés
// =============================================================================

enum VesselStatus {
  ACTIVE
  INACTIVE
  LAID_UP
  SOLD
}

model Vessel {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  code             String       @unique @db.VarChar(16)
  name             String       @db.VarChar(120)
  /// Numéro OMI 7 chiffres avec contrôle de clé (anti-doublon)
  imoNumber        String?      @unique @map("imo_number") @db.VarChar(7)
  mmsi             String?      @unique @db.VarChar(9)
  callSign         String?      @map("call_sign") @db.VarChar(16)
  /// Code pays ISO 3166-1 alpha-2 du pavillon
  flag             String?      @db.VarChar(2)
  portOfRegistry   String?      @map("port_of_registry") @db.VarChar(120)
  vesselType       String?      @map("vessel_type") @db.VarChar(80)
  status           VesselStatus @default(ACTIVE)
  managerName      String?      @map("manager_name") @db.VarChar(200)
  ownerName        String?      @map("owner_name") @db.VarChar(200)
  classSociety     String?      @map("class_society") @db.VarChar(120)
  yearBuilt        Int?         @map("year_built")
  builder          String?      @db.VarChar(200)
  grossTonnage     Decimal?     @map("gross_tonnage") @db.Decimal(12, 2)
  netTonnage       Decimal?     @map("net_tonnage") @db.Decimal(12, 2)
  deadweight       Decimal?     @db.Decimal(12, 2)
  lengthOverall    Decimal?     @map("length_overall") @db.Decimal(8, 2)
  beam             Decimal?     @db.Decimal(8, 2)
  summerDraft      Decimal?     @map("summer_draft") @db.Decimal(6, 2)
  /// Fuseau IANA pour l'affichage local (timestamps stockés en UTC)
  timezone         String       @default("UTC") @db.VarChar(64)
  contactEmail     String?      @map("contact_email") @db.VarChar(320)
  contactPhone     String?      @map("contact_phone") @db.VarChar(64)
  photoFileId      String?      @unique @map("photo_file_id") @db.Uuid
  notes            String?
  createdById      String?      @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company              @relation(fields: [companyId], references: [id])
  userAccess       UserVesselAccess[]
  files            StoredFile[]
  attachments      VesselAttachment[]
  crewAssignments  CrewAssignment[]
  certificates     Certificate[]
  csoLibrary       CsoLibrary?
  purchaseRequests PurchaseRequest[]
  rfqs             Rfq[]
  purchaseOrders   PurchaseOrder[]
  deliveryNotes    DeliveryNote[]
  goodsReceipts    GoodsReceipt[]
  voyages          Voyage[]
  noonReports      NoonReport[]
  charterParties   CharterParty[]

  @@index([companyId, status])
  @@map("vessels")
}

model VesselAttachment {
  id           String    @id @default(uuid()) @db.Uuid
  vesselId     String    @map("vessel_id") @db.Uuid
  fileId       String    @unique @map("file_id") @db.Uuid
  category     String    @db.VarChar(60)
  title        String    @db.VarChar(200)
  uploadedById String    @map("uploaded_by_id") @db.Uuid
