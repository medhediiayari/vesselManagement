/// Fiche unique d'une personne (marin ou personnel). Source des données personnelles communes.
model Member {
  id                    String          @id @default(uuid()) @db.Uuid
  companyId             String          @map("company_id") @db.Uuid
  /// Matricule AMC (clé de déduplication forte)
  amcRef                String?         @unique @map("amc_ref") @db.VarChar(32)
  firstName             String          @map("first_name") @db.VarChar(120)
  lastName              String          @map("last_name") @db.VarChar(120)
  birthDate             DateTime?       @map("birth_date") @db.Date
  birthPlace            String?         @map("birth_place") @db.VarChar(120)
  nationality           String?         @db.VarChar(2)
  gender                String?         @db.VarChar(16)
  email                 String?         @db.VarChar(320)
  phone                 String?         @db.VarChar(64)
  address               String?         @db.VarChar(500)
  emergencyContactName  String?         @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone String?         @map("emergency_contact_phone") @db.VarChar(64)
  passportNumber        String?         @map("passport_number") @db.VarChar(32)
  passportCountry       String?         @map("passport_country") @db.VarChar(2)
  passportExpiry        DateTime?       @map("passport_expiry") @db.Date
  seamanBookNumber      String?         @map("seaman_book_number") @db.VarChar(32)
  seamanBookExpiry      DateTime?       @map("seaman_book_expiry") @db.Date
  rank                  String?         @db.VarChar(120)
  crewDepartment        CrewDepartment? @map("crew_department")
  status                MemberStatus    @default(AVAILABLE)
  /// Département AMC (personnel à terre)
  departmentId          String?         @map("department_id") @db.Uuid
  photoFileId           String?         @unique @map("photo_file_id") @db.Uuid
  notes                 String?
  createdById           String?         @map("created_by_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt            DateTime?       @map("archived_at") @db.Timestamptz(3)

  company         Company            @relation(fields: [companyId], references: [id])
  user            User?              @relation("UserMember")
  crewAssignments CrewAssignment[]
  certificates    Certificate[]
  fieldValues     MemberFieldValue[]
  documents       MemberDocument[]

  @@index([lastName, firstName, birthDate])
  @@index([passportNumber])
  @@index([seamanBookNumber])
  @@index([status])
  @@map("members")
}

model MemberDocument {
  id           String    @id @default(uuid()) @db.Uuid
  memberId     String    @map("member_id") @db.Uuid
  fileId       String    @unique @map("file_id") @db.Uuid
  category     String    @db.VarChar(60)
  title        String    @db.VarChar(200)
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@map("member_documents")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

/// Sections personnalisées des fiches Members (ADM-038)
model MemberFieldSection {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(120)
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  fields MemberFieldDefinition[]

  @@map("member_field_sections")
}

/// Champs personnalisés Members uniquement (ADM-036/037) ; archivés, jamais supprimés (ADM-039)
model MemberFieldDefinition {
  id             String          @id @default(uuid()) @db.Uuid
  sectionId      String?         @map("section_id") @db.Uuid
  key            String          @unique @db.VarChar(64)
  label          String          @db.VarChar(120)
  type           CustomFieldType
  options        Json?
  required       Boolean         @default(false)
  sortOrder      Int             @default(0) @map("sort_order")
  /// Permission requise pour voir / éditer (null = members.view / members.edit)
  viewPermission String?         @map("view_permission") @db.VarChar(80)
  editPermission String?         @map("edit_permission") @db.VarChar(80)
  selfEditable   Boolean         @default(false) @map("self_editable")
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  section MemberFieldSection? @relation(fields: [sectionId], references: [id])
  values  MemberFieldValue[]

  @@map("member_field_definitions")
}

model MemberFieldValue {
  memberId    String   @map("member_id") @db.Uuid
  fieldId     String   @map("field_id") @db.Uuid
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  member Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  field  MemberFieldDefinition @relation(fields: [fieldId], references: [id])

  @@id([memberId, fieldId])
  @@map("member_field_values")
}

enum CrewAssignmentStatus {
  PLANNED
  ONBOARD
  COMPLETED
  CANCELLED
}

/// Historique temporel Member <-> Vessel (embarquements / débarquements)
model CrewAssignment {
  id                   String               @id @default(uuid()) @db.Uuid
  memberId             String               @map("member_id") @db.Uuid
  vesselId             String               @map("vessel_id") @db.Uuid
  rank                 String               @db.VarChar(120)
  position             String?              @db.VarChar(120)
  status               CrewAssignmentStatus @default(PLANNED)
  plannedJoinDate      DateTime?            @map("planned_join_date") @db.Date
  actualJoinDate       DateTime?            @map("actual_join_date") @db.Date
  plannedSignOffDate   DateTime?            @map("planned_sign_off_date") @db.Date
  actualSignOffDate    DateTime?            @map("actual_sign_off_date") @db.Date
  joinPort             String?              @map("join_port") @db.VarChar(120)
  signOffPort          String?              @map("sign_off_port") @db.VarChar(120)
  voyageId             String?              @map("voyage_id") @db.Uuid
  relievesAssignmentId String?              @map("relieves_assignment_id") @db.Uuid
  notes                String?
