# =====================================================================
# AMC Platform — configuration d'environnement (développement local)
# Copier vers .env (racine) ; l'API lit aussi ce fichier.
# Ne JAMAIS committer de secrets réels.
# =====================================================================

# --- Ports infra (choisis pour ne pas entrer en conflit avec d'autres stacks locales)
POSTGRES_PORT=5434
REDIS_PORT=6380
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
CLAMAV_PORT=3310

# --- PostgreSQL
POSTGRES_USER=amc
POSTGRES_PASSWORD=amc_dev_password
POSTGRES_DB=amc
DATABASE_URL=postgresql://amc:amc_dev_password@localhost:5434/amc?schema=public
# Base "shadow" utilisée uniquement pour générer des migrations (prisma migrate diff)
SHADOW_DATABASE_URL=postgresql://amc:amc_dev_password@localhost:5434/amc_shadow?schema=public

# --- MinIO (S3 compatible, buckets privés)
MINIO_ROOT_USER=amc_minio
MINIO_ROOT_PASSWORD=amc_minio_dev_password
S3_ENDPOINT=http://localhost:9100
# Endpoint utilisé pour SIGNER les URLs éphémères remises au navigateur
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=amc_minio
S3_SECRET_KEY=amc_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_BUCKET_FILES=amc-files
S3_BUCKET_QUARANTINE=amc-quarantine
S3_BUCKET_EXPORTS=amc-exports
# presigned = URL signée courte (CDC §1.1) ; proxy = flux servi par l'API (MinIO non exposé)
FILE_DELIVERY_MODE=presigned
SIGNED_URL_TTL_SECONDS=60
UPLOAD_MAX_BYTES=52428800

# --- Antivirus : disabled | clamav  (disabled => statut SKIPPED explicite, jamais "CLEAN")
AV_MODE=disabled
CLAMAV_HOST=localhost

# --- Redis / jobs
REDIS_URL=redis://localhost:6380
WORKERS_ENABLED=true

# --- Email : smtp (Mailpit en dev) | disabled
EMAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="AMC Platform <no-reply@amc.local>"

# --- API
API_PORT=4000
WEB_ORIGIN=http://localhost:3100
APP_BASE_URL=http://localhost:3100
COOKIE_SECURE=false
SESSION_ABSOLUTE_TTL_HOURS=720
# Valeur initiale ; modifiable ensuite par le Super Admin (system_settings)
SESSION_IDLE_TIMEOUT_MINUTES=60
LOG_LEVEL=info

# --- Seed (développement uniquement)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@amc.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_DEMO_PASSWORD=Demo!2026pass

# --- Web
API_INTERNAL_URL=http://localhost:4000
WEB_PORT=3100
